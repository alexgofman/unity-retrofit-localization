<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the engine-free tests with a plain .NET SDK, no Unity licence needed:
        dotnet test DotnetTests~
    The same test files run inside Unity as the EditMode assembly under Tests/Editor.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>RetrofitLocalization.Tests</AssemblyName>
    <RootNamespace>RetrofitLocalization.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Tests/Editor/Core/**/*.cs" LinkBase="Shared" />
    <Compile Include="DotnetOnly/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core/RetrofitLocalization.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
